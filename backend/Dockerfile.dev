# syntax=docker/dockerfile:1
FROM ruby:4.0.6

# 日本語環境の設定
ENV LANG C.UTF-8
ENV TZ Asia/Tokyo

# 必要なパッケージのインストール（RailsはAPIモードのみのため、Node.js/Yarnは不要）
RUN apt-get update -qq && apt-get install -y build-essential libpq-dev git vim curl
 
# アプリケーションディレクトリの作成
RUN mkdir /myapp
WORKDIR /myapp

# Bundlerのインストール
RUN gem install bundler

# ホストのファイルをコピー
COPY . /myapp
